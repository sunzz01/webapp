# ╔══════════════════════════════════════════════════════════════════╗
# ║  PicSeller — Environment Variables                                ║
# ║  Copy this file to .env and fill in your values                ║
# ╚══════════════════════════════════════════════════════════════════╝

# ─── Mode Selection ──────────────────────────────────────────────
# Production builds always use serverless API routes.
# Set this to "true" only when you want local Vite dev to call /api or VITE_API_BASE_URL.
VITE_USE_VERTEX_AI=false

# ─── Vertex AI (Production — Server-side) ────────────────────────
# These are used by API routes on Vercel (server-side only, not exposed to browser)

# Your GCP Project ID (from Google Cloud Console)
GCP_PROJECT_ID=your-gcp-project-id

# Region for Vertex AI (default: us-central1)
GCP_LOCATION=us-central1

# Gemini image generation models such as Gemini 3.1 Flash Image preview use the global endpoint.
GCP_IMAGE_LOCATION=global

# Product Content Generation 2-stage pipeline.
# Stage 1 uses gemini-2.5-flash as Prompt Orchestrator.
GCP_ORCHESTRATOR_LOCATION=global
# Stage 2 uses Imagen Product Recontext to preserve the product while changing scene/background.
GCP_RECONTEXT_LOCATION=us-central1
IMAGEN_RECONTEXT_MODEL=imagen-product-recontext-preview-06-30
# Imagen 4 text-to-image models use the regular Imagen predict endpoint.
GCP_IMAGEN4_LOCATION=us-central1

# Base64-encoded GCP Service Account JSON key
# 
# How to create & encode:
# 1. Go to https://console.cloud.google.com/iam-admin/serviceaccounts
# 2. Create a service account with "Vertex AI User" role
# 3. Create a JSON key and download it
# 4. Encode it:
#    - Linux/Mac:   cat service-account.json | base64
#    - PowerShell:  [Convert]::ToBase64String([IO.File]::ReadAllBytes("service-account.json"))
#    - Online:      https://www.base64encode.org/
#
GCP_SERVICE_ACCOUNT=

# ─── Direct Gemini API (Development — Client-side) ──────────────
# Used when VITE_USE_VERTEX_AI is false
# Get your API key at: https://aistudio.google.com/apikey

GEMINI_API_KEY=your-gemini-api-key
VITE_GEMINI_API_KEY=your-gemini-api-key

# ─── Optional: API Base URL Override ─────────────────────────────
# If you deploy API routes separately, set this to the API base URL
# VITE_API_BASE_URL=https://your-api-domain.vercel.app

# ─── Optional: Remove.bg API ─────────────────────────────────────
VITE_REMOVE_BG_API_KEY=

# ─── Optional: Override for local API development ────────────────
# If you want to test the API routes locally, set this:
# VITE_API_BASE_URL=http://localhost:3000

# ─── Firebase Authentication ────────────────────────────────────
# Frontend values from Firebase Console > Project settings > Your apps > Web app.
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=your-firebase-web-app-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
# Server-side bucket name used by Vercel API routes (same value, never expose as a VITE secret)
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Optional allowlist. Leave both blank to allow any Firebase-authenticated user.
# Recommended: put your email here before deploying.
VITE_ALLOWED_EMAILS=owner@example.com
VITE_ALLOWED_DOMAINS=

# Trial credits. Prefer email/domain allowlists; use VITE_UNLIMITED_CREDITS=true only for a private test deploy.
VITE_UNLIMITED_CREDITS=false
VITE_UNLIMITED_CREDIT_EMAILS=owner@example.com
VITE_UNLIMITED_CREDIT_DOMAINS=

# Backend value from Firebase Console > Project settings > Service accounts.
# Base64-encoded Firebase Admin SDK service account JSON.
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_ALLOWED_EMAILS=owner@example.com
FIREBASE_ALLOWED_DOMAINS=

# ─── Billing / Opn Payments (server-side only) ──────────────────
# Leave these blank while previewing the pricing UX.  The checkout only enables
# a method after its merchant credentials are present in Vercel Production.
# Do not prefix secret values with VITE_.
OPN_SECRET_KEY=
# Required in addition to the secret key for secure browser-side card tokenization.
OPN_PUBLIC_KEY=
# Optional, defaults to https://api.omise.co. Use the provider test endpoint only if instructed by Opn.
OPN_API_BASE_URL=
# Configure the Opn charge-complete event as:
# https://your-domain/api/payments/webhook?token=<this value>
OPN_WEBHOOK_TOKEN=
# The URL customers return to after an Alipay/card authorization. Default is the current Vercel domain.
PAYMENT_RETURN_URL=https://your-domain

# If a channel has a different source type enabled in your Opn merchant account,
# override it only after confirming with the official Opn documentation/support.
OPN_PROMPTPAY_SOURCE_TYPE=promptpay
OPN_TRUEMONEY_SOURCE_TYPE=truemoney
OPN_ALIPAY_SOURCE_TYPE=alipay
